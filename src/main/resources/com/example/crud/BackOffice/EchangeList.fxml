<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="600.0" prefWidth="1000.0" spacing="20.0" stylesheets="@../yassinestyle.css"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.crud.BackOffice.EchangeListController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Liste des Échanges" styleClass="h1">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Button fx:id="addButton" text="Ajouter" styleClass="action-button" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="echangeTable" layoutX="14.0" layoutY="14.0" prefHeight="400.0" prefWidth="800.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="imageColumn" prefWidth="100.0" text="Image" />
            <TableColumn fx:id="idObjetColumn" prefWidth="75.0" text="ID Objet" />
            <TableColumn fx:id="nameColumn" prefWidth="100.0" text="Name" />
            <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
            <TableColumn fx:id="messageColumn" prefWidth="150.0" text="Message" />
            <TableColumn fx:id="statutColumn" prefWidth="100.0" text="Statut" />
            <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
        </columns>
    </TableView>
</VBox> 