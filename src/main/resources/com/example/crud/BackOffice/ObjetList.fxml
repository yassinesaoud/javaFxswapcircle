<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="600.0" prefWidth="1000.0" spacing="20.0" stylesheets="@../yassinestyle.css"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.crud.BackOffice.ObjetListController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Liste des Objets" styleClass="h1">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Button fx:id="addButton" text="Ajouter" styleClass="action-button" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="objetTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="imageColumn" prefWidth="100.0" text="Image" />
            <TableColumn fx:id="nomColumn" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="descriptionColumn" prefWidth="200.0" text="Description" />
            <TableColumn fx:id="etatColumn" prefWidth="100.0" text="État" />
            <TableColumn fx:id="dateAjoutColumn" prefWidth="150.0" text="Date d'ajout" />
            <TableColumn fx:id="categorieColumn" prefWidth="100.0" text="Catégorie" />
            <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
        </columns>
    </TableView>
</VBox> 