<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane fx:id="mainPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="750.0" stylesheets="@../yassinestyle.css"
            styleClass="form-container" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.crud.BackOffice.ObjetFormController">
    <top>
        <VBox alignment="CENTER" spacing="12.0" styleClass="form-header">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="Formulaire d'Objet" styleClass="title"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane">
            <VBox alignment="CENTER" spacing="20.0" styleClass="form-content">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>
                <GridPane fx:id="formGrid" hgap="12" vgap="12" styleClass="form-body">
                    <Label text="Nom de l'objet:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <tooltip>
                            <Tooltip text="Entrez un nom descriptif"/>
                        </tooltip>
                    </Label>
                    <TextField fx:id="nomField" styleClass="input" promptText="Ex: Table en bois"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label fx:id="nomError" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Description:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <tooltip>
                            <Tooltip text="Décrivez l'objet en détail"/>
                        </tooltip>
                    </Label>
                    <TextArea fx:id="descriptionField" prefHeight="130.0" wrapText="true" styleClass="textarea"
                              promptText="Ex: Table en chêne massif" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label fx:id="descriptionError" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="État:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <tooltip>
                            <Tooltip text="Sélectionnez l'état"/>
                        </tooltip>
                    </Label>
                    <ComboBox fx:id="etatComboBox" prefWidth="280.0" styleClass="combo" promptText="Choisir l'état"
                              GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label fx:id="etatError" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Catégorie:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="6">
                        <tooltip>
                            <Tooltip text="Choisissez une catégorie"/>
                        </tooltip>
                    </Label>
                    <ComboBox fx:id="categorieComboBox" prefWidth="280.0" styleClass="combo" promptText="Choisir la catégorie"
                              GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    <Label fx:id="categorieError" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label text="Image:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="8">
                        <tooltip>
                            <Tooltip text="Sélectionnez une image (PNG/JPG)"/>
                        </tooltip>
                    </Label>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="8">
                        <TextField fx:id="imageField" styleClass="input" promptText="Chemin de l'image" editable="false"/>
                        <Button fx:id="uploadButton" text="Choisir" styleClass="action-button" onAction="#handleImageUpload"/>
                    </HBox>
                    <Label fx:id="imageError" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                    <ImageView fx:id="imagePreview" fitHeight="90.0" fitWidth="90.0" preserveRatio="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="10">
                        <clip>
                            <Rectangle width="90.0" height="90.0" arcWidth="10.0" arcHeight="10.0"/>
                        </clip>
                    </ImageView>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15.0" styleClass="form-footer">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <ProgressBar fx:id="progressBar" prefWidth="250.0" progress="0.0" styleClass="progress-bar" visible="false"/>
            <Button fx:id="saveButton" text="Enregistrer" styleClass="primary-button" onAction="#handleSave">
                <tooltip>
                    <Tooltip text="Sauvegarder"/>
                </tooltip>
            </Button>
            <Button fx:id="cancelButton" text="Annuler" styleClass="secondary-button" onAction="#handleCancel">
                <tooltip>
                    <Tooltip text="Annuler"/>
                </tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>