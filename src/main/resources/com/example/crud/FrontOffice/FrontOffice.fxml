<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.example.crud.FrontOffice.FrontOfficeController"
      stylesheets="@../styles/frontoffice.css">

    <top>
        <!-- Navigation Bar -->
        <HBox styleClass="navbar">
            <!-- Logo and Brand -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <Image url="@../icons/frontend.png"/>
                </ImageView>
                <Label text="SwapCircle" styleClass="brand-title" onMouseClicked="#handleHome">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </HBox>

            <!-- Navigation Links -->
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="objetsBtn" text="Objets" styleClass="nav-button" onAction="#handleObjets"/>
                <Button fx:id="ajouterObjetBtn" text="Ajouter un Objet" styleClass="nav-button" onAction="#handleAjouterObjet"/>
            </HBox>

            <!-- Admin Section -->
            <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                <Button fx:id="backOfficeBtn" text="Back Office" styleClass="nav-button, admin-button" onAction="#handleBackOffice"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox>
            <!-- Welcome Section -->
            <VBox fx:id="welcomeSection" styleClass="welcome-section" alignment="CENTER" spacing="20">
                <Label text="Bienvenue sur SwapCircle" styleClass="welcome-title">
                    <font>
                        <Font size="40"/>
                    </font>
                </Label>
                <Label text="La plateforme d'échange d'objets qui donne une seconde vie à vos biens" 
                       styleClass="welcome-subtitle" wrapText="true" alignment="CENTER">
                    <font>
                        <Font size="20"/>
                    </font>
                </Label>
                <Button text="Commencer à Échanger" styleClass="cta-button" onAction="#handleStartSwapping"/>
            </VBox>

            <!-- Features Section -->
            <HBox fx:id="featuresSection" styleClass="features-section" spacing="30" alignment="CENTER">
                <!-- Feature 1 -->
                <VBox styleClass="feature-card" alignment="CENTER" spacing="15">
                    <ImageView fitHeight="64" fitWidth="64">
                        <Image url="@../icons/echange.png"/>
                    </ImageView>
                    <Label text="Échangez Facilement" styleClass="feature-title"/>
                    <Label text="Trouvez des objets qui vous intéressent et proposez vos échanges en quelques clics" 
                           styleClass="feature-description" wrapText="true"/>
                </VBox>

                <!-- Feature 2 -->
                <VBox styleClass="feature-card" alignment="CENTER" spacing="15">
                    <ImageView fitHeight="64" fitWidth="64">
                        <Image url="@../icons/community.png"/>
                    </ImageView>
                    <Label text="Communauté Active" styleClass="feature-title"/>
                    <Label text="Rejoignez une communauté dynamique de personnes partageant les mêmes valeurs" 
                           styleClass="feature-description" wrapText="true"/>
                </VBox>

                <!-- Feature 3 -->
                <VBox styleClass="feature-card" alignment="CENTER" spacing="15">
                    <ImageView fitHeight="64" fitWidth="64">
                        <Image url="@../icons/eco.png"/>
                    </ImageView>
                    <Label text="Écologique" styleClass="feature-title"/>
                    <Label text="Contribuez à la réduction des déchets en donnant une seconde vie aux objets" 
                           styleClass="feature-description" wrapText="true"/>
                </VBox>
            </HBox>

            <!-- Content Area -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Content will be loaded here dynamically -->
            </StackPane>
        </VBox>
    </center>

</BorderPane> 